# Local development — matches docker-compose.yml (orbit-postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/IssueTracker"

# Basis-URL der Anwendung. Auth.js nutzt sie für Callbacks, `lib/invitations.ts`
# für den kopierbaren Einladungslink. Lokal reicht der Fallback
# (http://localhost:3000); in Produktion ist sie Pflicht, sonst zeigen die Links
# auf localhost.
# AUTH_URL=https://issues.example.com

# Auth.js — Pflicht. Zufälligen Wert generieren mit: bunx auth secret
AUTH_SECRET="dev-secret-minimum-32-characters-long!"

# Kein Passwort-Login mehr. Passkeys (WebAuthn) laufen immer, ohne
# Konfiguration — alles Weitere unten ist optional und rein additiv.

# Optionale OAuth-Provider.
# GitHub:  https://github.com/settings/developers
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# Google:  https://console.cloud.google.com/apis/credentials
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Ein generischer OIDC-Provider (Keycloak, Authentik, Entra ID, Okta, ...).
# AUTH_OIDC_NAME ist nur die Beschriftung des Buttons (Vorgabe "SSO").
# AUTH_OIDC_ISSUER="https://idp.example.com"
# AUTH_OIDC_CLIENT_ID=""
# AUTH_OIDC_CLIENT_SECRET=""
# AUTH_OIDC_NAME="Company SSO"

# SMTP — optional, aber der einzige Weg, wie sich ein schon bestehendes Konto
# ohne Passkey (z. B. eine offene Einladung) je einloggen kann: Passkeys
# lassen sich für eine schon existierende Adresse nur mit aktiver Sitzung
# registrieren (next-auth verweigert das sonst als `AccountNotLinked`), Magic
# Link nicht — der Klick auf den Link ist der Beweis, dass die Adresse der
# Person gehört. Ohne SMTP_HOST verschickt die App gar keine Mails (siehe
# `lib/mail`); Einladungslinks und Benachrichtigungen bleiben dann rein
# In-App/zum Kopieren, wie ohne diesen Abschnitt — Einladungen lassen sich
# dann aber nicht mehr annehmen.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="user@example.com"
# SMTP_PASS="..."
# Absenderadresse im `From`-Header. Ohne Angabe: "Issue Tracker <no-reply@$SMTP_HOST>".
# SMTP_FROM="Issue Tracker <no-reply@example.com>"

# Name/Adresse in der Fußzeile jeder Mail (viele Anbieter erwarten eine
# physische Adresse in kommerziellen Mails). Ohne Angabe bleibt die Zeile weg,
# statt eine erfundene Adresse zu zeigen.
# MAIL_COMPANY_NAME="Deine Firma GmbH"
# MAIL_COMPANY_ADDRESS="Straße 1, 12345 Stadt"
