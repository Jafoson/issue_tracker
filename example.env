# Local development — matches docker-compose.yml (orbit-postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/IssueTracker"

# Basis-URL der Anwendung. Auth.js nutzt sie für Callbacks, `lib/invitations.ts`
# für den kopierbaren Einladungslink. Lokal reicht der Fallback
# (http://localhost:3000); in Produktion ist sie Pflicht, sonst zeigen die Links
# auf localhost.
# AUTH_URL=https://issues.example.com

# Auth.js — Pflicht. Zufälligen Wert generieren mit: bunx auth secret
AUTH_SECRET="dev-secret-minimum-32-characters-long!"

# Kein Passwort-Login mehr. Passkeys (WebAuthn) laufen immer, ohne
# Konfiguration — alles Weitere unten ist optional und rein additiv.

# Optionale OAuth-Provider.
# GitHub:  https://github.com/settings/developers
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# Google:  https://console.cloud.google.com/apis/credentials
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# GitLab:  https://gitlab.com/-/user_settings/applications (oder die
#          Anwendungen-Seite einer selbst gehosteten Instanz)
# AUTH_GITLAB_ID=""
# AUTH_GITLAB_SECRET=""
# Microsoft Entra ID (Azure AD): https://portal.azure.com — App-Registrierung
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Ohne ISSUER dürfen sich beliebige Microsoft-Konten anmelden (privat, Schule,
# Arbeit). Nur den eigenen Tenant erlauben: Directory (tenant) ID eintragen.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Apple: https://developer.apple.com/account/resources/identifiers — braucht
# eine zahlende Apple-Developer-Mitgliedschaft, funktioniert nur über HTTPS
# (kein localhost) und das Secret ist ein selbst signiertes JWT statt eines
# festen Strings. `npx auth add apple` fragt alles ab und trägt beide Werte
# hier ein.
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# Ein generischer OIDC-Provider (Keycloak, Authentik, Entra ID, Okta, ...).
# AUTH_OIDC_NAME ist nur die Beschriftung des Buttons (Vorgabe "SSO").
# AUTH_OIDC_ISSUER="https://idp.example.com"
# AUTH_OIDC_CLIENT_ID=""
# AUTH_OIDC_CLIENT_SECRET=""
# AUTH_OIDC_NAME="Company SSO"

# SMTP — optional, aber der einzige Weg, wie sich ein schon bestehendes Konto
# ohne Passkey (z. B. eine offene Einladung) je einloggen kann: Passkeys
# lassen sich für eine schon existierende Adresse nur mit aktiver Sitzung
# registrieren (next-auth verweigert das sonst als `AccountNotLinked`), Magic
# Link nicht — der Klick auf den Link ist der Beweis, dass die Adresse der
# Person gehört. Ohne SMTP_HOST verschickt die App gar keine Mails (siehe
# `lib/mail`); Einladungslinks und Benachrichtigungen bleiben dann rein
# In-App/zum Kopieren, wie ohne diesen Abschnitt — Einladungen lassen sich
# dann aber nicht mehr annehmen.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="user@example.com"
# SMTP_PASS="..."
# Absenderadresse im `From`-Header. Ohne Angabe: "Issue Tracker <no-reply@$SMTP_HOST>".
# SMTP_FROM="Issue Tracker <no-reply@example.com>"

# Name/Adresse in der Fußzeile jeder Mail (viele Anbieter erwarten eine
# physische Adresse in kommerziellen Mails). Ohne Angabe bleibt die Zeile weg,
# statt eine erfundene Adresse zu zeigen.
# MAIL_COMPANY_NAME="Deine Firma GmbH"
# MAIL_COMPANY_ADDRESS="Straße 1, 12345 Stadt"

# S3-kompatibler Objektspeicher (`lib/storage`) — bislang nur für Avatare
# (User/Workspace). Funktioniert mit AWS S3 genauso wie mit jedem anderen
# S3-kompatiblen Anbieter (rustfs, MinIO, ...). Ohne S3_ENDPOINT bleibt
# Avatar-Upload aus; die App läuft mit reinen Initialen-Avataren weiter, wie
# schon vor dieser Funktion. Der Bucket muss privat sein — Lesezugriff läuft
# über serverseitig signierte, zeitlich begrenzte URLs.
# Adressierung ist immer Path-Style (<endpoint>/<bucket>/<key>) — funktioniert
# für rustfs, MinIO und AWS S3 gleichermaßen. Lokal: rustfs unter
# http://localhost:9000. Bei AWS S3: S3_ENDPOINT auf den regionalen Endpoint
# setzen, z.B. "https://s3.eu-central-1.amazonaws.com".
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_AVATARS="avatars"
