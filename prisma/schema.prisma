generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── RBAC-Enums ───────────────────────────────────────────────────────────────

/// Wo eine Rolle vergeben werden kann. Ein Permission-Key nennt nur Objekt und
/// Aktion (`issue.create`) — der Scope der Rolle sagt, worauf sie wirkt.
enum RoleScope {
  PLATFORM
  WORKSPACE
  PROJECT
}

/// Wer beim Anlegen und beim Beitritt automatisch ins Projekt eingetragen wird.
/// Über den Zugriff selbst entscheidet allein `ProjectMember` — ein privates
/// Projekt hat nur die, die ausdrücklich aufgenommen wurden.
enum ProjectVisibility {
  public
  private
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id
  name      String
  slug      String   @unique
  color     String   @default("#6e63e6")
  // Plattform-Ebene: ein Workspace = ein Tenant. `suspended` deaktiviert den
  // Zugriff ohne Löschen (vom Plattform-Admin gesetzt).
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Wozu der Workspace da ist, in ein bis zwei Sätzen. Steht im Steckbrief
  /// unter dem Namen; leer heißt, dass es niemand gesagt hat.
  desc      String   @default("")

  members       WorkspaceMember[]
  projects      Project[]
  labels        Label[]
  teams         Team[]
  invitations   Invitation[]
  statuses      WorkspaceStatus[]
  priorities    WorkspacePriority[]
  issueTypes    WorkspaceIssueType[]
  roles         Role[]
  // Wie einzelne Personen das Dashboard dieses Workspace eingerichtet haben.
  dashboards    WorkspaceDashboardPreference[]
  // Wichtige externe Adressen — Dokumentation, Repository, Chat.
  links         WorkspaceLink[]
  notifications Notification[]
}

/// Eine wichtige externe Adresse eines Workspace — Dokumentation, Repository,
/// Chat, was sonst dazugehört. Steht im Steckbrief als Reihe großer Chips
/// direkt unter der Kopfkarte.
model WorkspaceLink {
  id          String @id
  workspaceId String
  label       String
  url         String
  /// Reihenfolge der Chips. Explizit statt aus der Anlagezeit abgeleitet, weil
  /// sich eine Reihenfolge im Steckbrief per Hand einrichten lassen soll.
  position    Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  // @default(cuid()) ist für den Auth.js-Adapter nötig: dessen createUser strippt
  // die id und überlässt die Generierung der DB. Bestehende Zeilen sind unberührt.
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  handle         String    @unique
  email          String    @unique
  color          String
  passwordHash   String?
  // Auth.js-Adapter-Felder (OAuth). handle/color werden im createUser-Override gefüllt.
  emailVerified  DateTime?
  image          String?
  // Rolle im Scope PLATFORM. Steuert Plattform-Operationen und gewährt für sich
  // genommen KEINEN Zugriff auf Mandanteninhalte — dafür braucht die Rolle
  // ausdrücklich `tenant.access`.
  platformRoleId String?
  platformRole   Role?     @relation("UserPlatformRole", fields: [platformRoleId], references: [id], onDelete: SetNull)

  /// Seit wann es das Konto gibt. Die Plattformverwaltung zeigt es an; sonst
  /// interessiert es niemanden.
  createdAt     DateTime  @default(now())
  /// Wann zuletzt ein Lebenszeichen kam. Grob gehalten (siehe `lib/presence.ts`):
  /// die Spalte wird höchstens einmal je Stunde nachgezogen, weil sie sonst bei
  /// jedem Seitenaufruf einen Schreibvorgang kostete.
  lastSeenAt    DateTime?
  /// Gesetzt heißt: stillgelegt. Das Konto bleibt samt allem, was daran hängt,
  /// bekommt aber keinerlei Rechte mehr (`lib/permissions.ts`) und kommt nicht
  /// mehr herein (`auth.ts`). Das Gegenstück zum Löschen, das Issues, Kommentare
  /// und Zuweisungen mitnähme.
  deactivatedAt DateTime?

  workspaces          WorkspaceMember[]
  assignedIssues      Issue[]                        @relation("IssueAssignee")
  reportedIssues      Issue[]                        @relation("IssueReporter")
  comments            Comment[]
  leadingTeams        Team[]                         @relation("TeamLead")
  teamMemberships     TeamMember[]
  projectMemberships  ProjectMember[]
  createdProjects     Project[]                      @relation("ProjectCreator")
  accounts            Account[]
  sessions            Session[]
  invitations         Invitation[]
  preferences         UserPreferences?
  dashboards          DashboardPreference[]
  workspaceDashboards WorkspaceDashboardPreference[]
  notifications       Notification[]                 @relation("NotificationRecipient")
  notificationsCaused Notification[]                 @relation("NotificationActor")
}

/// Was einer Person gehört und keinem Workspace: wie die Oberfläche aussieht und
/// worüber sie benachrichtigt werden will.
///
/// Eigene Tabelle statt weiterer Spalten an `User`, weil hier nur Vorlieben
/// stehen — nichts davon entscheidet über Zugriff, und `User` wird bei jeder
/// Rechteprüfung gelesen. Die Zeile entsteht erst beim ersten Speichern
/// (`upsert`); wer nie etwas eingestellt hat, hat keine — gelesen wird dann der
/// Satz aus `features/account/queries.ts`, der dieselben Vorgaben trägt wie die
/// `@default`s hier.
model UserPreferences {
  userId String @id

  /// "dark" | "light" | "system" — landet als `data-theme` am Dokument.
  theme String @default("dark")

  /// Der Hinweis im Plattform-Bereich, was dort zu sehen ist und was nicht.
  /// Weggeklickt bleibt weggeklickt — und weil die Seite server-gerendert ist,
  /// steht die Antwort hier und nicht im `localStorage`: sonst zeigte der Server
  /// den Hinweis und der Browser nähme ihn beim Hydrieren wieder weg.
  adminNoticeHidden Boolean @default(false)

  // Benachrichtigungen, je Anlass einmal für die App und einmal für die Mail.
  // Es gibt noch keinen Mailversand; die Spalten stehen trotzdem hier, damit die
  // Wahl schon getroffen werden kann und nicht später nachgeholt werden muss.
  assignedInApp  Boolean @default(true)
  assignedEmail  Boolean @default(true)
  mentionedInApp Boolean @default(true)
  mentionedEmail Boolean @default(true)
  commentInApp   Boolean @default(true)
  commentEmail   Boolean @default(false)
  statusInApp    Boolean @default(true)
  statusEmail    Boolean @default(false)
  inviteInApp    Boolean @default(true)
  inviteEmail    Boolean @default(true)
  roleInApp      Boolean @default(true)
  roleEmail      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Das Projekt-Dashboard, wie es einer eingerichtet hat ────────────────────
//
// Eine Zeile je Person **und** Projekt. Das Dashboard gehört keinem Projekt und
// keinem Team, sondern dem, der es ansieht: wer Aufgaben verteilt, will die
// Auslastung oben haben, wer selbst welche abarbeitet, den Rückstand. Beide auf
// dieselbe Anordnung festzulegen hieße, einem von beiden die falsche Seite zu
// zeigen.
//
// Die Zeile entsteht erst, wenn jemand etwas verstellt — wie `UserPreferences`.
// Wer nie etwas anfasst, bekommt die Vorgabe aus `features/dashboard/widgets.ts`,
// und die Oberfläche muss den Unterschied nicht kennen.

model DashboardPreference {
  userId    String
  projectId String

  /// Bausteine, die diese Person ausgeblendet hat — Keys aus `WIDGETS`.
  hidden String[]

  /// Die Reihenfolge, in der die Bausteine stehen. Unvollständig gespeichert:
  /// was hier fehlt, behält seinen Platz aus der Vorgabe. Sonst erschiene ein
  /// später ergänzter Baustein bei niemandem mehr, der einmal etwas verschoben
  /// hat.
  order String[]

  /// Der Zeitraum, mit dem das Dashboard aufgeht — "7d" | "30d" | "90d" | "12m".
  /// Steht auch in der Adresse (`?range=`); hier steht, womit es ohne Angabe
  /// beginnt.
  range String @default("30d")

  /// Welche der beiden Ansichten zuletzt offen war — "profile" | "dashboard".
  ///
  /// Die Projektzeile in der Seitenleiste führt ohne `?view=` auf diese Seite;
  /// wer zuletzt die Zahlen ansah, soll sie beim nächsten Klick wieder sehen und
  /// nicht erst wieder umschalten. Die Vorgabe ist der Steckbrief: er beantwortet
  /// „was ist das hier" und gilt auch für den, der das Projekt zum ersten Mal
  /// öffnet.
  view String @default("profile")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

/// Wie eine Person das Dashboard eines Workspace eingerichtet hat — dasselbe
/// Muster wie `DashboardPreference` eine Ebene tiefer, nur ohne `view`: Dashboard
/// und Übersicht sind beim Workspace zwei eigene Routen mit je einem eigenen
/// Navlink in der Seitenleiste, keine Ansicht, die sich eine Zeile merken muss.
model WorkspaceDashboardPreference {
  userId      String
  workspaceId String

  /// Bausteine, die diese Person ausgeblendet hat — Keys aus `WIDGETS`.
  hidden String[]

  /// Die Reihenfolge, in der die Bausteine stehen. Unvollständig gespeichert,
  /// siehe `DashboardPreference.order`.
  order String[]

  /// Der Zeitraum, mit dem das Dashboard aufgeht — "7d" | "30d" | "90d" | "12m".
  range String @default("30d")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

// ─── Auth.js (NextAuth) ─────────────────────────────────────────────────────────
// Standard-Adapter-Modelle. Session bleibt bei JWT-Strategie ungenutzt, wird aber
// vom PrismaAdapter typseitig erwartet.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  // Rolle auf der Workspace-Ebene (Role.scope = WORKSPACE, gleicher Workspace).
  roleId      String
  pending     Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: eine Rolle, die noch jemand trägt, lässt sich nicht löschen.
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([roleId])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String            @id
  workspaceId  String
  name         String
  slug         String
  prefix       String
  color        String
  /// Wozu das Projekt da ist, in einem Satz. Steht in der Projektübersicht
  /// neben dem Namen; leer heißt schlicht, dass es niemand gesagt hat.
  desc         String            @default("")
  lastIssueKey Int               @default(0)
  visibility   ProjectVisibility @default(public)

  /// Wann es angelegt wurde.
  createdAt   DateTime  @default(now())
  /// Gesetzt heißt: stillgelegt. Das Projekt bleibt lesbar, aber es ist erkennbar
  /// aus dem Betrieb — die Plattformverwaltung findet daran verwaiste Projekte.
  archivedAt  DateTime?
  /// Wer es angelegt hat. `SetNull`, weil ein gelöschtes Konto das Projekt nicht
  /// mitnehmen darf — genau dann wird das Projekt zum Waisen, den die
  /// Plattformverwaltung neu zuordnen muss.
  createdById String?
  createdBy   User?     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues        Issue[]
  teams         TeamProject[]
  labels        Label[]
  members       ProjectMember[]
  invitations   Invitation[]
  // Workspace-Labels, die in diesem Projekt nicht angeboten werden.
  hiddenLabels  ProjectHiddenLabel[]
  // Projektlokale Rollen (Role.scope = PROJECT mit gesetztem projectId).
  roles         Role[]
  // Wie einzelne Personen das Dashboard dieses Projekts eingerichtet haben.
  dashboards    DashboardPreference[]
  notifications Notification[]

  @@unique([workspaceId, prefix])
  @@unique([workspaceId, slug])
}

// ─── Project membership (wer im Projekt ist, mit welcher Rolle) ───────────────
//
// Eine Zeile je Person und Projekt, für **jeden**, der im Projekt ist — das
// Gegenstück zu `WorkspaceMember` eine Ebene tiefer. Wer im Workspace ist, wird
// in dessen öffentlichen Projekten mit einer passenden Projektrolle eingetragen
// (lib/project-membership.ts). Danach ist diese Rolle unabhängig: sie gilt in
// genau diesem Projekt und lässt sich dort ändern, ohne den Workspace anzufassen.
//
// Diese Tabelle ist die Zugriffsentscheidung für alles Projektbezogene: keine
// Zeile heißt kein Zugriff (lib/permissions.ts). `Project.visibility` steuert
// deshalb nur noch, wer beim Anlegen automatisch eingetragen wird.

/// Woher die Rolle einer `ProjectMember`-Zeile stammt.
///
/// `manual` heißt: ein Projektleiter hat sie ausdrücklich gesetzt (per
/// Mitgliederliste oder Einladung) — oder sie ist die Standardrolle aus der
/// Workspace-Aufnahme (`lib/project-membership.ts`). `team` heißt: sie kommt
/// aus einem Team, das mit einer Rolle an diesem Projekt hängt. Der
/// Unterschied entscheidet, wer eine Zeile beim Nachziehen der Team-Rollen
/// anfassen darf — eine `manual`-Zeile fasst `syncProjectTeamRoles` nie an.
enum ProjectMemberOrigin {
  manual
  team
}

model ProjectMember {
  projectId String
  userId    String
  // Rolle auf der Projekt-Ebene (Role.scope = PROJECT). Entweder eine
  // workspaceweite Projektrolle oder eine projektlokale. Sie ist in diesem
  // Projekt die ganze Wahrheit: was hier nicht steht, gilt hier nicht. Die
  // Workspace-Rolle greift nur über `project.admin.all` durch.
  roleId    String

  /// Siehe `ProjectMemberOrigin`. Default `manual`, damit jede bestehende und
  /// jede von Hand gesetzte Zeile unangetastet bleibt.
  origin ProjectMemberOrigin @default(manual)
  /// Nur bei `origin = team` gesetzt: welches Team diese Rolle zuletzt
  /// begründet hat — reine Anzeige ("via Team X"). `SetNull`, weil das Team
  /// verschwinden kann, ohne dass die (dann verwaiste) Zeile mitgerissen wird;
  /// der nächste Sync räumt sie ohnehin auf.
  originTeamId String?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  originTeam Team?   @relation(fields: [originTeamId], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@index([userId])
  @@index([roleId])
  @@index([originTeamId])
}

// ─── Einladungen ──────────────────────────────────────────────────────────────
//
// Wer per E-Mail eingeladen wird, bekommt sofort ein Konto — ohne Passwort und
// mit `WorkspaceMember.pending = true`. Diese Zeile ist der Weg von dort zum
// fertigen Zugang: `token` ist der Einladungslink, und angenommen wird er genau
// einmal (`acceptedAt`). Beim Annehmen entstehen Passwort und Name, `pending`
// fällt weg, und die Projektmitgliedschaften werden nachgezogen
// (`features/auth/actions.ts`).
//
// Ohne Mailversand zeigt die Oberfläche den Link zum Kopieren. Sobald es Mail
// gibt, verschickt sie dieselbe URL — die Tabelle bleibt, wie sie ist.
//
// Ein Projekt-Gast hat keine Workspace-Mitgliedschaft. Für den gilt dieselbe
// Zeile: `workspaceId` sagt nur, wo die Einladung herkam.

model Invitation {
  token       String    @id
  workspaceId String
  userId      String
  /// Projekt, aus dem die Einladung kam — Ziel des Sprungs nach der Annahme.
  projectId   String?
  createdAt   DateTime  @default(now())
  expires     DateTime
  /// Gesetzt, sobald der Zugang eingerichtet wurde. Danach ist der Token tot.
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId])
  @@index([workspaceId])
}

// ─── Global config (shared across workspaces via join tables) ─────────────────

model Status {
  id       String  @id
  name     String
  short    String
  color    String
  isColumn Boolean @default(true)
  position Int

  workspaces WorkspaceStatus[]
}

model WorkspaceStatus {
  workspaceId String
  statusId    String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status    Status    @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@id([workspaceId, statusId])
}

model Priority {
  id       Int    @id
  key      String @unique
  name     String
  color    String
  position Int

  workspaces WorkspacePriority[]
}

model WorkspacePriority {
  workspaceId String
  priorityId  Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priority  Priority  @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@id([workspaceId, priorityId])
}

model IssueType {
  id       String @id
  name     String
  color    String
  position Int

  workspaces WorkspaceIssueType[]
}

model WorkspaceIssueType {
  workspaceId String
  issueTypeId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueType IssueType @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)

  @@id([workspaceId, issueTypeId])
}

// ─── Rollen & Permissions (RBAC) ──────────────────────────────────────────────

// `scope` sagt, wo eine Rolle vergeben werden kann. Wem sie gehört, sagen die
// beiden Eigentümerspalten — und die sind bei den Default-Rollen leer:
//
//   system  scope        workspaceId  projectId   Bedeutung
//   ──────────────────────────────────────────────────────────────────────────
//   true    (jeder)      null         null        Default-Rolle, existiert
//                                                 GENAU EINMAL für alle
//   false   PLATFORM     null         null        eigene Plattform-Rolle
//   false   WORKSPACE    <ws>         null        eigene Rolle dieses Workspace
//   false   PROJECT      <ws>         null        eigene Rolle, in allen
//                                                 Projekten des Workspace
//   false   PROJECT      <ws>         <p>         eigene Rolle, nur in diesem
//                                                 Projekt
//
// System-Rollen sind nicht editierbar: sie werden von allen Mandanten geteilt,
// eine Änderung träfe also jeden. Wer eine Abwandlung braucht, legt eine eigene
// Rolle an.
//
// `key` ist die stabile, code-referenzierbare ID. Die Eindeutigkeit von (Scope,
// Eigentümer, key) sichern partielle Unique-Indizes ab, die in der Migration von
// Hand angelegt werden — ein `@@unique` über nullable Spalten würde in Postgres
// nicht greifen (NULL ist dort von jedem anderen NULL verschieden).
// Nachgeschlagen wird über die deterministisch gebildete `id` (lib/rbac/id.ts).
model Role {
  id          String    @id
  scope       RoleScope
  workspaceId String?
  projectId   String?
  key         String
  name        String
  desc        String    @default("")
  rank        Int       @default(0)
  editable    Boolean   @default(true)
  /// Default-Rolle aus lib/rbac/roles.ts — gehört niemandem, gilt für alle.
  system      Boolean   @default(false)

  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  platformUsers    User[]            @relation("UserPlatformRole")
  // Team-Projekt-Verknüpfungen, die diese Rolle verleihen.
  teamProjects     TeamProject[]

  @@index([scope, workspaceId])
  @@index([projectId])
}

// Permission-Keys sind hardcoded im Code (lib/rbac/permissions.ts). Die Tabelle
// dient als FK-Ziel und dokumentiert die verfügbaren Permissions.
//
// Ein Key nennt nur Objekt und Aktion (`issue.create`, `label.update`) — in
// welchen Scopes er vergeben werden darf, steht in der Registry, nicht hier.
// Dieselbe Permission wirkt in einer Workspace-Rolle workspaceweit und in einer
// Projektrolle nur in diesem Projekt.
model Permission {
  key  String @id
  desc String @default("")

  roles RolePermission[]
}

// Eine Zeile heißt: diese Rolle hat diese Permission. Es gibt keine Gegenrichtung.
//
// Früher stand hier ein `effect` mit ALLOW und DENY. Das war nötig, solange eine
// Prüfung mehrere Rollen vereinigte und ein Recht von oben wieder weggenommen
// werden musste. Seit jeder Kontext genau eine Rolle auflöst (lib/permissions.ts)
// kann eine Rolle pro Permission ohnehin nur eine Zeile haben — ein DENY wäre von
// „keine Zeile" nicht zu unterscheiden gewesen. Ein Verbotsschild, das nichts
// verbietet, ist in einer Rechtetabelle schlimmer als keines.
//
// Kämen einmal Rechte über Teams dazu, würden wieder mehrere Rollen zusammenlaufen
// und ein Verbot bekäme wieder eine Bedeutung. Dann gehört es für diesen Fall neu
// entworfen, statt einen Rest aus einem anderen Modell weiterzuschleppen.
model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// ─── Labels (workspace-specific) ─────────────────────────────────────────────

model Label {
  id          String  @id
  workspaceId String
  projectId   String?
  name        String
  slug        String
  color       String

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hiddenIn  ProjectHiddenLabel[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([projectId])
}

// Ein Workspace-Label gilt in jedem Projekt. Wo es nicht passt, blendet das
// Projekt es aus: eine Zeile hier heißt „dieses Label steht in diesem Projekt
// nicht mehr zur Auswahl". Das Label selbst bleibt unangetastet — es gehört dem
// Workspace, und in anderen Projekten wird es weiter vergeben.
//
// Ausblenden nimmt es nur aus der Auswahl, nicht von den Aufgaben, die es schon
// tragen: sonst verschwände mit einem Klick eine Einteilung, die jemand bewusst
// gesetzt hat — und zwar unwiederbringlich, denn `Issue.labels` ist ein Array
// ohne Historie. Wieder eingeblendet, ist alles wie zuvor.
//
// Für Projekt-Labels ist die Tabelle ohne Bedeutung: die gelten ohnehin nur in
// ihrem eigenen Projekt, dort wären sie zu löschen statt auszublenden.
model ProjectHiddenLabel {
  projectId String
  labelId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@index([labelId])
}

// ─── Issues ──────────────────────────────────────────────────────────────────

model Issue {
  id       String @id
  key      Int
  title    String
  status   String @default("backlog")
  priority Int    @default(0)

  // ProseMirror-Dokument. Angezeigt wird es von `components/ui/atoms/RichText`,
  // geschrieben von `RichTextEditor`.
  description     Json   @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  // Aus `description` abgeleiteter Fließtext — `contains` arbeitet nicht auf
  // einer Json-Spalte, die Volltextsuche in `getProjectIssues` braucht ihn.
  // Wird in `features/issues/actions.ts` bei jedem Schreibvorgang neu gesetzt.
  descriptionText String @default("")

  type    String   @default("feature")
  labels  String[]
  rank    Float    @default(0)
  created DateTime @default(now())
  updated DateTime @updatedAt

  /// Wann die Aufgabe abgeschlossen wurde — gesetzt, sobald ihr Status auf
  /// „done" oder „canceled" wechselt, und wieder geleert, wenn sie zurück in die
  /// Arbeit geht (`features/issues/actions.ts`).
  ///
  /// Eine eigene Spalte, obwohl `updated` beim Abschließen dasselbe Datum trägt:
  /// `updated` verschiebt sich bei jeder späteren Änderung mit — ein Kommentar,
  /// ein Label, ein Tippfehler im Titel. Das Dashboard misst daran den Durchsatz
  /// und die Durchlaufzeit, und beide wären damit nicht bloß ungenau, sondern
  /// rückwirkend veränderlich.
  closedAt DateTime?

  assigneeId String?
  reporterId String
  projectId  String

  assignee      User?          @relation("IssueAssignee", fields: [assigneeId], references: [id])
  reporter      User           @relation("IssueReporter", fields: [reporterId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  comments      Comment[]
  notifications Notification[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([assigneeId])
  // Der Durchsatz des Dashboards gruppiert je Projekt über diese Spalte.
  @@index([projectId, closedAt])
}

// ─── Comments ────────────────────────────────────────────────────────────────

model Comment {
  id       String   @id
  // Wie `Issue.description`: ProseMirror-Dokument plus abgeleiteter Fließtext
  // für Vorschauen (Inbox) und spätere Suche.
  body     Json
  bodyText String   @default("")
  created  DateTime @default(now())

  issueId  String
  authorId String

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

// ─── Benachrichtigungen ─────────────────────────────────────────────────────
//
// Eine Zeile je Empfänger und Anlass — Anlässe stehen in `NOTIFICATION_EVENTS`
// (`features/account/types.ts`), gegen `UserPreferences.{type}InApp` geprüft,
// bevor die Zeile überhaupt entsteht (`lib/notify`). `projectId` trennt
// Workspace- von Projekt-Ereignissen: gesetzt heißt projekt-, `null`
// workspace-bezogen — genau die Grenze, an der die Inbox filtert.
//
// `actorLabel` ist wie `AuditLog.actorLabel` zur Schreibzeit eingefroren: wer
// später sein Konto umbenennt oder verliert, verändert damit nicht rückwirkend,
// was in einer schon zugestellten Benachrichtigung steht.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// Schlüssel aus `NOTIFICATION_EVENTS` — assigned, mentioned, comment,
  /// status, invite, role.
  type      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  workspaceId String
  /// Gesetzt = projekt-bezogen, `null` = workspace-bezogen.
  projectId   String?
  issueId     String?

  actorId    String?
  actorLabel String  @default("")
  /// Zusatztext je nach `type`: Rollenname (role/invite), Statuskey (status)
  /// oder Kommentar-Vorschau (comment/mentioned).
  text       String  @default("")

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, projectId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id          String @id
  workspaceId String
  name        String
  key         String
  color       String
  desc        String @default("")

  leadId String
  lead   User   @relation("TeamLead", fields: [leadId], references: [id])

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  projects  TeamProject[]
  // Zeilen, deren Rolle zuletzt von diesem Team begründet wurde (Anzeige,
  // siehe `ProjectMember.originTeam`).
  grantedMembers ProjectMember[]

  @@unique([workspaceId, key])
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

/// Verknüpft ein Team mit einem Projekt — zur Gruppierung (offene Aufgaben in
/// der Team-Übersicht) und optional mit einer Rolle, die das Team dort
/// verleiht.
///
/// `roleId` ist bewusst nullable: ein Team lässt sich weiterhin ohne Rolle an
/// ein Projekt hängen, rein zur Zuordnung, ohne dass seine Mitglieder dadurch
/// Zugriff bekommen. Erst eine gesetzte Rolle lässt `syncProjectTeamRoles`
/// (`lib/project-membership.ts`) `ProjectMember`-Zeilen für die Mitglieder
/// nachziehen.
model TeamProject {
  teamId    String
  projectId String
  roleId    String?

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict wie bei ProjectMember: eine Rolle, die noch ein Team trägt, lässt
  // sich nicht löschen.
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([teamId, projectId])
  @@index([roleId])
}

// ─── Audit-Log ────────────────────────────────────────────────────────────────
//
// Was auf der Plattform geschehen ist, in der Reihenfolge, in der es geschah:
// Anmeldungen, Rollenwechsel, Stilllegungen, Löschungen — und jeder
// Notfall-Zugriff auf ein Projekt (`lib/audit.ts`).
//
// **Diese Tabelle hat mit Absicht keine Fremdschlüssel.** Ein Protokoll, das
// mitgelöscht wird, wenn jemand das Konto löscht, über dessen Tat es berichtet,
// ist kein Protokoll. Deshalb stehen hier nur nackte Ids — und daneben die
// Beschriftungen, wie sie zur Tatzeit galten. Wer den Namen von heute sehen
// will, schlägt ihn über die Id nach; wer wissen will, was damals auf dem
// Bildschirm stand, liest das Label.
//
// Geschrieben wird nur, nie geändert und nie gelöscht. Es gibt dafür keine
// Server Action — `recordAudit()` ist der einzige Weg hinein.

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Schlüssel aus `AUDIT_ACTIONS` (lib/audit.ts) — z. B. `auth.login`.
  action String

  /// Wer gehandelt hat. Null bei einem fehlgeschlagenen Anmeldeversuch, bei dem
  /// niemand feststeht.
  actorId    String?
  /// Name und Adresse zur Tatzeit, damit die Zeile für sich lesbar bleibt.
  actorLabel String

  /// Woran gehandelt wurde. Frei gehalten (`user`, `project`, `workspace`,
  /// `role`), damit eine neue Objektart keine neue Spalte braucht.
  targetType  String?
  targetId    String?
  targetLabel String?

  /// Wo es geschah — für die Einordnung, nicht für einen Join.
  workspaceId String?
  projectId   String?

  /// Die Begründung, die beim Notfall-Zugriff verlangt wird. Sonst leer.
  reason String?

  /// Was sonst noch zur Tat gehört (alte und neue Rolle etwa). Bewusst formfrei:
  /// das Protokoll soll nicht bei jedem neuen Vorgang wandern müssen.
  meta Json?

  /// Die Liste wird immer nach Zeit gelesen, meist gefiltert nach Vorgang,
  /// Handelndem oder Ort.
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// ─── Mail-Vorlagen (Admin-Override) ────────────────────────────────────────────
//
// Jede Vorlage in `lib/mail/templates/` hat einen Code-Default. Diese Tabelle
// überschreibt davon nur drei Textbausteine — Betreff, Überschrift,
// Einleitungstext — mit `{{platzhalter}}`-Syntax für Namen und Links; siehe
// `MAIL_TEMPLATE_CATALOG` in `features/mail-templates/catalog.ts` für die
// gültigen Schlüssel und Platzhalter je Vorlage. Layout, Detailtabellen und
// der Knopftext bleiben immer Code — eine kaputte Vorlage kann höchstens
// falschen Text zeigen, nie das Layout brechen oder Escaping umgehen.
//
// Fehlt eine Zeile zu einem Schlüssel, gilt der Code-Default unverändert —
// wie bei jeder anderen Einstellung in dieser App mit Vorgabewert.

model MailTemplate {
  /// Aus `MAIL_TEMPLATE_KEYS`, z. B. `invitation` oder `notification.assigned`.
  key String @id

  subject  String
  heading  String
  bodyText String

  updatedAt DateTime @updatedAt
}
