generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── RBAC-Enums ───────────────────────────────────────────────────────────────

/// Wo eine Rolle vergeben werden kann. Ein Permission-Key nennt nur Objekt und
/// Aktion (`issue.create`) — der Scope der Rolle sagt, worauf sie wirkt.
enum RoleScope {
  PLATFORM
  WORKSPACE
  PROJECT
}

/// Ein DENY sticht über alle Ebenen hinweg jedes ALLOW.
enum PermissionEffect {
  ALLOW
  DENY
}

/// Wer beim Anlegen und beim Beitritt automatisch ins Projekt eingetragen wird.
/// Über den Zugriff selbst entscheidet allein `ProjectMember` — ein privates
/// Projekt hat nur die, die ausdrücklich aufgenommen wurden.
enum ProjectVisibility {
  public
  private
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id
  name      String
  slug      String   @unique
  color     String   @default("#6e63e6")
  // Plattform-Ebene: ein Workspace = ein Tenant. `suspended` deaktiviert den
  // Zugriff ohne Löschen (vom Plattform-Admin gesetzt).
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())

  members     WorkspaceMember[]
  projects    Project[]
  labels      Label[]
  teams       Team[]
  invitations Invitation[]
  statuses    WorkspaceStatus[]
  priorities  WorkspacePriority[]
  issueTypes  WorkspaceIssueType[]
  roles       Role[]
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  // @default(cuid()) ist für den Auth.js-Adapter nötig: dessen createUser strippt
  // die id und überlässt die Generierung der DB. Bestehende Zeilen sind unberührt.
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  handle         String    @unique
  email          String    @unique
  color          String
  passwordHash   String?
  // Auth.js-Adapter-Felder (OAuth). handle/color werden im createUser-Override gefüllt.
  emailVerified  DateTime?
  image          String?
  // Rolle im Scope PLATFORM. Steuert Plattform-Operationen und gewährt für sich
  // genommen KEINEN Zugriff auf Mandanteninhalte — dafür braucht die Rolle
  // ausdrücklich `tenant.access`.
  platformRoleId String?
  platformRole   Role?     @relation("UserPlatformRole", fields: [platformRoleId], references: [id], onDelete: SetNull)

  workspaces         WorkspaceMember[]
  assignedIssues     Issue[]           @relation("IssueAssignee")
  reportedIssues     Issue[]           @relation("IssueReporter")
  comments           Comment[]
  leadingTeams       Team[]            @relation("TeamLead")
  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  accounts           Account[]
  sessions           Session[]
  invitations        Invitation[]
}

// ─── Auth.js (NextAuth) ─────────────────────────────────────────────────────────
// Standard-Adapter-Modelle. Session bleibt bei JWT-Strategie ungenutzt, wird aber
// vom PrismaAdapter typseitig erwartet.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  // Rolle auf der Workspace-Ebene (Role.scope = WORKSPACE, gleicher Workspace).
  roleId      String
  pending     Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: eine Rolle, die noch jemand trägt, lässt sich nicht löschen.
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([roleId])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String            @id
  workspaceId  String
  name         String
  slug         String
  prefix       String
  color        String
  lastIssueKey Int               @default(0)
  visibility   ProjectVisibility @default(public)

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues      Issue[]
  teams       TeamProject[]
  labels      Label[]
  members     ProjectMember[]
  invitations Invitation[]
  // Projektlokale Rollen (Role.scope = PROJECT mit gesetztem projectId).
  roles       Role[]

  @@unique([workspaceId, prefix])
  @@unique([workspaceId, slug])
}

// ─── Project membership (wer im Projekt ist, mit welcher Rolle) ───────────────
//
// Eine Zeile je Person und Projekt, für **jeden**, der im Projekt ist — das
// Gegenstück zu `WorkspaceMember` eine Ebene tiefer. Wer im Workspace ist, wird
// in dessen öffentlichen Projekten mit einer passenden Projektrolle eingetragen
// (lib/project-membership.ts). Danach ist diese Rolle unabhängig: sie gilt in
// genau diesem Projekt und lässt sich dort ändern, ohne den Workspace anzufassen.
//
// Diese Tabelle ist die Zugriffsentscheidung für alles Projektbezogene: keine
// Zeile heißt kein Zugriff (lib/permissions.ts). `Project.visibility` steuert
// deshalb nur noch, wer beim Anlegen automatisch eingetragen wird.

model ProjectMember {
  projectId String
  userId    String
  // Rolle auf der Projekt-Ebene (Role.scope = PROJECT). Entweder eine
  // workspaceweite Projektrolle oder eine projektlokale. Sie **ersetzt** in
  // diesem Projekt die Workspace-Rolle: was hier erlaubt ist, gilt — ein DENY
  // der oberen Ebenen bleibt aber ein DENY.
  roleId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@index([roleId])
}

// ─── Einladungen ──────────────────────────────────────────────────────────────
//
// Wer per E-Mail eingeladen wird, bekommt sofort ein Konto — ohne Passwort und
// mit `WorkspaceMember.pending = true`. Diese Zeile ist der Weg von dort zum
// fertigen Zugang: `token` ist der Einladungslink, und angenommen wird er genau
// einmal (`acceptedAt`). Beim Annehmen entstehen Passwort und Name, `pending`
// fällt weg, und die Projektmitgliedschaften werden nachgezogen
// (`features/auth/actions.ts`).
//
// Ohne Mailversand zeigt die Oberfläche den Link zum Kopieren. Sobald es Mail
// gibt, verschickt sie dieselbe URL — die Tabelle bleibt, wie sie ist.
//
// Ein Projekt-Gast hat keine Workspace-Mitgliedschaft. Für den gilt dieselbe
// Zeile: `workspaceId` sagt nur, wo die Einladung herkam.

model Invitation {
  token       String    @id
  workspaceId String
  userId      String
  /// Projekt, aus dem die Einladung kam — Ziel des Sprungs nach der Annahme.
  projectId   String?
  createdAt   DateTime  @default(now())
  expires     DateTime
  /// Gesetzt, sobald der Zugang eingerichtet wurde. Danach ist der Token tot.
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId])
  @@index([workspaceId])
}

// ─── Global config (shared across workspaces via join tables) ─────────────────

model Status {
  id       String  @id
  name     String
  short    String
  color    String
  isColumn Boolean @default(true)
  position Int

  workspaces WorkspaceStatus[]
}

model WorkspaceStatus {
  workspaceId String
  statusId    String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status    Status    @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@id([workspaceId, statusId])
}

model Priority {
  id       Int    @id
  key      String @unique
  name     String
  color    String
  position Int

  workspaces WorkspacePriority[]
}

model WorkspacePriority {
  workspaceId String
  priorityId  Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priority  Priority  @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@id([workspaceId, priorityId])
}

model IssueType {
  id       String @id
  name     String
  color    String
  position Int

  workspaces WorkspaceIssueType[]
}

model WorkspaceIssueType {
  workspaceId String
  issueTypeId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueType IssueType @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)

  @@id([workspaceId, issueTypeId])
}

// ─── Rollen & Permissions (RBAC) ──────────────────────────────────────────────

// `scope` sagt, wo eine Rolle vergeben werden kann. Wem sie gehört, sagen die
// beiden Eigentümerspalten — und die sind bei den Default-Rollen leer:
//
//   system  scope        workspaceId  projectId   Bedeutung
//   ──────────────────────────────────────────────────────────────────────────
//   true    (jeder)      null         null        Default-Rolle, existiert
//                                                 GENAU EINMAL für alle
//   false   PLATFORM     null         null        eigene Plattform-Rolle
//   false   WORKSPACE    <ws>         null        eigene Rolle dieses Workspace
//   false   PROJECT      <ws>         null        eigene Rolle, in allen
//                                                 Projekten des Workspace
//   false   PROJECT      <ws>         <p>         eigene Rolle, nur in diesem
//                                                 Projekt
//
// System-Rollen sind nicht editierbar: sie werden von allen Mandanten geteilt,
// eine Änderung träfe also jeden. Wer eine Abwandlung braucht, legt eine eigene
// Rolle an.
//
// `key` ist die stabile, code-referenzierbare ID. Die Eindeutigkeit von (Scope,
// Eigentümer, key) sichern partielle Unique-Indizes ab, die in der Migration von
// Hand angelegt werden — ein `@@unique` über nullable Spalten würde in Postgres
// nicht greifen (NULL ist dort von jedem anderen NULL verschieden).
// Nachgeschlagen wird über die deterministisch gebildete `id` (lib/rbac/id.ts).
model Role {
  id          String    @id
  scope       RoleScope
  workspaceId String?
  projectId   String?
  key         String
  name        String
  desc        String    @default("")
  rank        Int       @default(0)
  editable    Boolean   @default(true)
  /// Default-Rolle aus lib/rbac/roles.ts — gehört niemandem, gilt für alle.
  system      Boolean   @default(false)

  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  platformUsers    User[]            @relation("UserPlatformRole")

  @@index([scope, workspaceId])
  @@index([projectId])
}

// Permission-Keys sind hardcoded im Code (lib/rbac/permissions.ts). Die Tabelle
// dient als FK-Ziel und dokumentiert die verfügbaren Permissions.
//
// Ein Key nennt nur Objekt und Aktion (`issue.create`, `label.update`) — in
// welchen Scopes er vergeben werden darf, steht in der Registry, nicht hier.
// Dieselbe Permission wirkt in einer Workspace-Rolle workspaceweit und in einer
// Projektrolle nur in diesem Projekt.
model Permission {
  key  String @id
  desc String @default("")

  roles RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  effect        PermissionEffect @default(ALLOW)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// ─── Labels (workspace-specific) ─────────────────────────────────────────────

model Label {
  id          String  @id
  workspaceId String
  projectId   String?
  name        String
  slug        String
  color       String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([projectId])
}

// ─── Issues ──────────────────────────────────────────────────────────────────

model Issue {
  id       String @id
  key      Int
  title    String
  status   String @default("backlog")
  priority Int    @default(0)

  // ProseMirror-Dokument. Angezeigt wird es von `components/ui/atoms/RichText`,
  // geschrieben von `RichTextEditor`.
  description     Json   @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  // Aus `description` abgeleiteter Fließtext — `contains` arbeitet nicht auf
  // einer Json-Spalte, die Volltextsuche in `getProjectIssues` braucht ihn.
  // Wird in `features/issues/actions.ts` bei jedem Schreibvorgang neu gesetzt.
  descriptionText String @default("")

  type    String   @default("feature")
  labels  String[]
  rank    Float    @default(0)
  created DateTime @default(now())
  updated DateTime @updatedAt

  assigneeId String?
  reporterId String
  projectId  String

  assignee User?     @relation("IssueAssignee", fields: [assigneeId], references: [id])
  reporter User      @relation("IssueReporter", fields: [reporterId], references: [id])
  project  Project   @relation(fields: [projectId], references: [id])
  comments Comment[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([assigneeId])
}

// ─── Comments ────────────────────────────────────────────────────────────────

model Comment {
  id       String   @id
  // Wie `Issue.description`: ProseMirror-Dokument plus abgeleiteter Fließtext
  // für Vorschauen (Inbox) und spätere Suche.
  body     Json
  bodyText String   @default("")
  created  DateTime @default(now())

  issueId  String
  authorId String

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id          String @id
  workspaceId String
  name        String
  key         String
  color       String
  desc        String @default("")

  leadId String
  lead   User   @relation("TeamLead", fields: [leadId], references: [id])

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  projects  TeamProject[]

  @@unique([workspaceId, key])
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model TeamProject {
  teamId    String
  projectId String

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([teamId, projectId])
}
